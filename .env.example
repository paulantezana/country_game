# Copia este archivo como ".env" (en la misma carpeta) y completa lo que necesites.
# Todo es opcional.

# Clave de Euler Stream (https://www.eulerstream.com) para el servidor de firma de TikTok.
# Sin clave funciona con el límite gratuito; con clave aguanta más conexiones/reconexiones.
SIGN_API_KEY=

# Usuario de TikTok que aparece ya escrito en el panel (sin @).
TIKTOK_USERNAME=

# Puerto del servidor (por defecto 3000, el de config.json).
# PORT=3000
